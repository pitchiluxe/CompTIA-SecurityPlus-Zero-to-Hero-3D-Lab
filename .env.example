# Presence/WebSocket server for live user counter
# Frontend reads VITE_ prefixed variables at build time.
# For Vercel, set this under Project Settings > Environment Variables and rebuild.
VITE_PRESENCE_WS=ws://localhost:4000
# Example for a deployed server:
# VITE_PRESENCE_WS=wss://your-presence-server.onrender.com

# Server-side CORS origin (optional). Leave empty to allow any origin.
PRESENCE_ORIGIN=
# Example:
# PRESENCE_ORIGIN=https://comptiasecuritypluslab.vercel.app
